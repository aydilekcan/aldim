# Supabase Edge Function Secrets only. Never add these to NEXT_PUBLIC_ / EXPO_PUBLIC_.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Optional: only scoped admin tests may email this exact address; cron email stays off.
REMINDER_EMAIL_TEST_TO=
SMS_PROVIDER=netgsm
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
# Optional alternative: set SMS_PROVIDER=twilio explicitly.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
