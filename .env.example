# Aldım — örnek environment dosyası.
# Bu dosyayı `.env.local` olarak kopyalayıp kendi değerlerini gir.
# MVP'de hiçbiri zorunlu değildir — uygulama tamamen client-side
# (localStorage) çalışır. Aşağıdaki anahtarlar bir sonraki faz
# (Supabase auth + sync, e-posta hatırlatma, cron) için yer tutucudur.

# Canlı dağıtımın tam URL'i. Örn. https://aldim.vercel.app
NEXT_PUBLIC_APP_URL=

# Supabase (auth + cloud sync — gelecek faz)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (e-posta uyarıları — gelecek faz)
RESEND_API_KEY=

# Vercel Cron handler'larını korumak için paylaşılan sır
CRON_SECRET=
